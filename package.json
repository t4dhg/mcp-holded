{
  "name": "@t4dhg/mcp-holded",
  "version": "3.0.0",
  "mcpName": "io.github.t4dhg/mcp-holded",
  "description": "MCP server for the Holded API v2: contacts, sales and purchase documents, payments, treasury, accounting, catalog, team, CRM, projects, calendar, inbox and webhooks, with confirmation gates on every destructive operation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-holded": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist coverage .vitest test-results",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.json\" \"*.json\" \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.json\" \"*.json\" \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\"",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run test:smoke",
    "scan": "node scripts/preflight-scan.mjs",
    "prepublishOnly": "npm run audit && npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build && npm run check:package && npm run test:smoke",
    "audit": "npm audit --audit-level=low",
    "check:package": "node scripts/check-package.mjs",
    "test:smoke": "node scripts/stdio-smoke.mjs",
    "setup:hooks": "husky",
    "test:package-checker": "node --test scripts/check-package.test.mjs",
    "smoke:live": "node scripts/smoke-test.mjs"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "holded",
    "holded-api",
    "holded-mcp",
    "erp",
    "invoicing",
    "accounting",
    "bookkeeping",
    "facturacion",
    "contabilidad",
    "tesoreria",
    "verifactu",
    "crm",
    "treasury",
    "payments",
    "spain",
    "spanish",
    "claude",
    "claude-code",
    "cursor",
    "anthropic",
    "ai",
    "llm",
    "ai-integration"
  ],
  "author": "Taig Mac Carthy <taigmaccarthy@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/t4dhg/mcp-holded#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4dhg/mcp-holded.git"
  },
  "bugs": {
    "url": "https://github.com/t4dhg/mcp-holded/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "vite": "^6.4.5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
